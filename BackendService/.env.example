# Application
APP_NAME="Wiki to Neo4j Extraction API"
API_PREFIX="/api/v1"                 # Base API path prefix used by the service
HOST="0.0.0.0"                       # Bind address for uvicorn
PORT=3001                            # Port the service listens on (default 3001)

# Environment (optional; for your own deployment tagging)
APP_ENV="development"                # e.g., development | staging | production
LOG_LEVEL="info"                     # e.g., debug | info | warning | error

# Base path (optional; not consumed directly by code)
# Used by some deployments/reverse proxies; the service uses API_PREFIX directly.
BASE_PATH="/"

# JWT Authentication
JWT_SECRET="dev-secret-change-me"    # Secret used to sign JWTs
JWT_ALGORITHM="HS256"                # Algorithm used for JWT signing
JWT_EXPIRE_MINUTES=60                # Token expiration window in minutes
JWT_ISSUER="wiki-backend"            # Expected 'iss' claim
JWT_AUDIENCE="wiki-clients"          # Expected 'aud' claim

# Embeddings Provider (OpenAI optional)
# If OPENAI_API_KEY is set, EmbeddingProvider uses OpenAI text-embedding-3-small.
# If not set, a deterministic stub embedding is used.
EMBEDDINGS_PROVIDER="openai"         # Informational; code auto-detects by OPENAI_API_KEY
OPENAI_API_KEY=""                    # e.g., sk-...

# Neo4j Configuration (optional; if not set, client operates in no-op mode)
NEO4J_URI="bolt://localhost:7687"    # e.g., bolt://localhost:7687
NEO4J_USER="neo4j"                   # e.g., neo4j
NEO4J_PASSWORD="neo4j_password"      # e.g., your password

# CORS
# Comma-separated list of allowed origins for browsers.
# Note: The current code allows all (*) by default. Customize middleware if you want to enforce this list.
CORS_ALLOW_ORIGINS="http://localhost:5173,http://localhost:3000"
