# Application
APP_NAME=Wiki to Neo4j Extraction API
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=3001

# Authentication (JWT)
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=wiki-backend
JWT_AUDIENCE=wiki-clients

# Optional OpenAI (leave empty to use deterministic stub embeddings)
OPENAI_API_KEY=

# Neo4j configuration (leave empty to run in no-op mode)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# Optional CORS origins (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
